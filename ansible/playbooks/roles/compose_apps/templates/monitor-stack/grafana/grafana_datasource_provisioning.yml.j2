apiVersion: 1
datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: false
  - name: Prometheus Talos
    type: prometheus
    access: proxy
    # Cilium LB-IPAM address pinned in k8s-talos/infrastructure/monitoring/helmrelease.yaml
    url: http://192.168.100.200:9090
    isDefault: false
