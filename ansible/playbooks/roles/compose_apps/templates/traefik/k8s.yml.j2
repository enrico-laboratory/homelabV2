# Generated by Ansible: k8s hostnames are passed through to the ingress-nginx
# service (TLS is terminated in the cluster by cert-manager certificates).
tcp:
  routers:
    k8s-ingress:
      entryPoints:
        - websecure
      rule: "{% for h in k8s_hostnames %}HostSNI(`{{ h }}`){% if not loop.last %} || {% endif %}{% endfor %}"
      service: k8s-ingress
      tls:
        passthrough: true
  services:
    k8s-ingress:
      loadBalancer:
        servers:
          - address: "{{ k8s_ingress_ip }}:443"

http:
  routers:
    k8s-ingress-http:
      entryPoints:
        - web
      rule: "{% for h in k8s_hostnames %}Host(`{{ h }}`){% if not loop.last %} || {% endif %}{% endfor %}"
      priority: 10
      service: k8s-ingress-http
    https-redirect:
      entryPoints:
        - web
      rule: "HostRegexp(`.+`)"
      priority: 1
      middlewares:
        - redirect-https
      service: noop@internal
  middlewares:
    redirect-https:
      redirectScheme:
        scheme: https
        permanent: true
  services:
    k8s-ingress-http:
      loadBalancer:
        servers:
          - url: "http://{{ k8s_ingress_ip }}:80"
