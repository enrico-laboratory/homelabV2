# Generated by Ansible: Talos hostnames are passed through to the Cilium Gateway
# (TLS is terminated there with the wildcard certificate from cert-manager).
tcp:
  routers:
    # PROXY protocol v2 carries the original client address, otherwise every connection
    # would appear to come from this host.
    talos-gateway:
      entryPoints:
        - websecure
      rule: "{% for h in talos_hostnames %}HostSNI(`{{ h }}`){% if not loop.last %} || {% endif %}{% endfor %}"
      service: talos-gateway
      tls:
        passthrough: true
  services:
    talos-gateway:
      loadBalancer:
        proxyProtocol:
          version: 2
        servers:
          - address: "{{ talos_gateway_ip }}:443"

http:
  routers:
    https-redirect:
      entryPoints:
        - web
      rule: "HostRegexp(`.+`)"
      priority: 1
      middlewares:
        - redirect-https
      service: noop@internal
  middlewares:
    redirect-https:
      redirectScheme:
        scheme: https
        permanent: true
