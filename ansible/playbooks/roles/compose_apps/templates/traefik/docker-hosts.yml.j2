# Generated by Ansible: ops Docker services that are not on the shared "main"
# network (host network or own compose network), routed via their published port.
http:
  routers:
{% for s in host_services %}
    {{ s.name }}:
      entryPoints:
        - websecure
      rule: "Host(`{{ s.name }}.enricoruggieri.com`)"
      service: {{ s.name }}
      tls:
        certResolver: cf
{% endfor %}
  services:
{% for s in host_services %}
    {{ s.name }}:
      loadBalancer:
        servers:
          - url: "{{ s.url if s.url is defined else 'http://' ~ inventory_hostname ~ ':' ~ s.port }}"
{% endfor %}
